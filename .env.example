# HuggingFace API token (required for private models, higher rate limits)
HF_TOKEN=your_hf_token_here

# Database path (relative to project root)
CACHE_DB_PATH=data/modelrank.db

# API server configuration
API_HOST=0.0.0.0
API_PORT=8000

# Gradio UI configuration
UI_HOST=0.0.0.0
UI_PORT=7860

# Cache TTLs (seconds)
CACHE_TTL_METADATA=86400
CACHE_TTL_EVALS=21600

# CORS allowed origins (comma-separated, use * for all)
ALLOWED_ORIGINS=*

# Logging level
LOG_LEVEL=INFO

# NotebookLM integration (optional)
# Run 'notebooklm login' to set up authentication
NOTEBOOKLM_ENABLED=false
